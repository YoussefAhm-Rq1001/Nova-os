#!/bin/sh
set -eu
glib-compile-schemas /usr/share/glib-2.0/schemas
chmod -R a+rX /usr/share/gnome-shell/extensions/nova-clock@nova-os

mkdir -p /etc/dconf/profile /etc/dconf/db/gdm.d
cat > /etc/dconf/profile/gdm <<EOF
user-db:user
system-db:gdm
file-db:/usr/share/gdm/greeter-dconf-defaults
EOF
cat > /etc/dconf/db/gdm.d/00-nova-greeter <<EOF
[org/gnome/desktop/background]
picture-uri='file:///usr/share/backgrounds/nova/nova-space.svg'
picture-uri-dark='file:///usr/share/backgrounds/nova/nova-space.svg'
picture-options='zoom'
EOF
dconf update

mkdir -p /usr/share/plymouth/themes/nova
rsvg-convert -w 256 -h 256 /usr/share/backgrounds/nova/nova-boot-mark.svg -o /usr/share/plymouth/themes/nova/nova-mark.png
update-alternatives --install /usr/share/plymouth/themes/default.plymouth default.plymouth /usr/share/plymouth/themes/nova/nova.plymouth 200
update-alternatives --set default.plymouth /usr/share/plymouth/themes/nova/nova.plymouth
update-desktop-database /usr/share/applications || true
exit 0