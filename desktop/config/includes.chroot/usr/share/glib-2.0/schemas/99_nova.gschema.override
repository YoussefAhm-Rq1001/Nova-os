[org.gnome.desktop.background]
picture-uri='file:///usr/share/backgrounds/nova/nova-space.svg'
picture-uri-dark='file:///usr/share/backgrounds/nova/nova-space.svg'
picture-options='zoom'
color-shading-type='solid'
primary-color='#080f22'
secondary-color='#080f22'

[org.gnome.desktop.interface]
font-name='Noto Sans 10'
document-font-name='Noto Sans 10'
monospace-font-name='Noto Sans Mono 10'
color-scheme='prefer-dark'

[org.gnome.shell]
enabled-extensions=['ubuntu-dock@ubuntu.com', 'nova-clock@nova-os']
favorite-apps=['google-chrome.desktop', 'brave-browser.desktop', 'code.desktop', 'org.gnome.Nautilus.desktop', 'org.gnome.Settings.desktop']

[org.gnome.shell.extensions.dash-to-dock]
dock-position='BOTTOM'
extend-height=false
dock-fixed=true
dash-max-icon-size=48
transparency-mode='FIXED'
background-opacity=0.24
show-show-apps-button=true
